{
  "name": "chinese-prosody-marker",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --mac",
    "electron:build:dir": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.prosody.marker",
    "productName": "中文韵律标记助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/__pycache__",
      "!server/*.pyc"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": null
    },
    "win": {
      "target": ["portable"],
      "icon": null
    }
  }
}
